{
  "name": "@jmozez/mcpmedic",
  "version": "0.1.0",
  "description": "Check your MCP server before your users do. Lints tool definitions and reports problems, token cost and fixes.",
  "type": "module",
  "bin": {
    "mcpmedic": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "hosts",
    "action.yml",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "coverage": "vitest run --coverage --coverage.include='src/**'"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "lint",
    "ai-agents",
    "testing",
    "cli"
  ],
  "author": "jmozez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmozez/mcpmedic.git"
  },
  "homepage": "https://github.com/jmozez/mcpmedic#readme",
  "bugs": {
    "url": "https://github.com/jmozez/mcpmedic/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.20.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
